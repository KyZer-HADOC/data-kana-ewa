<Window x:Class="DataKanaEwa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Kana Ewa" Height="700" Width="920" MinHeight="540" MinWidth="760"
        Background="#0F1117" Foreground="#E6E8EF" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8A90A2"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#181B24" CornerRadius="15" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222736"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4F8CFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Data Kana Ewa" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Which app is using your internet data" Foreground="#8A90A2" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <RadioButton GroupName="period" Tag="today" Content="Today" IsChecked="True" Style="{StaticResource Pill}" Checked="Period_Checked"/>
                <RadioButton GroupName="period" Tag="week" Content="7 days" Style="{StaticResource Pill}" Checked="Period_Checked"/>
                <RadioButton GroupName="period" Tag="month" Content="30 days" Style="{StaticResource Pill}" Checked="Period_Checked"/>
                <RadioButton GroupName="period" Tag="all" Content="All time" Style="{StaticResource Pill}" Checked="Period_Checked"/>
            </StackPanel>
        </DockPanel>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
            <Border Background="#181B24" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Downloaded" Foreground="#8A90A2" FontSize="12"/>
                    <TextBlock x:Name="TotalDown" Text="0 B" FontSize="22" FontWeight="Bold" Foreground="#3DDC97" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#181B24" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Uploaded" Foreground="#8A90A2" FontSize="12"/>
                    <TextBlock x:Name="TotalUp" Text="0 B" FontSize="22" FontWeight="Bold" Foreground="#FFB454" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#181B24" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Download speed" Foreground="#8A90A2" FontSize="12"/>
                    <TextBlock x:Name="SpeedDown" Text="0 B/s" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#181B24" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Upload speed" Foreground="#8A90A2" FontSize="12"/>
                    <TextBlock x:Name="SpeedUp" Text="0 B/s" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Search -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid HorizontalAlignment="Left" Width="300">
                <TextBox x:Name="Search" Background="#181B24" Foreground="#E6E8EF" BorderBrush="#2A2F3D"
                         CaretBrush="White" Padding="10,7" FontSize="13" TextChanged="Search_TextChanged"/>
                <TextBlock Text="Search apps..." Foreground="#6B7186" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock x:Name="AppCount" Text="0 apps" Foreground="#8A90A2" FontSize="13"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Column header -->
        <Grid Grid.Row="3" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="APP" Foreground="#6B7186" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="DOWNLOAD" Foreground="#6B7186" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="UPLOAD" Foreground="#6B7186" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="TOTAL" Foreground="#6B7186" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        </Grid>

        <!-- App list -->
        <Grid Grid.Row="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsHost">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#181B24" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="36" Height="36" CornerRadius="18" Background="{Binding Accent}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Foreground="#8A90A2" FontSize="12"/>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Share, Mode=OneWay}"
                                                     Height="5" Margin="0,6,0,0" BorderThickness="0"
                                                     Background="#252A36" Foreground="{Binding Accent}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding DownText}" Foreground="#3DDC97"
                                               FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding UpText}" Foreground="#FFB454"
                                               FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding TotalText}" FontWeight="SemiBold"
                                               FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Text="Waiting for network activity..." Foreground="#6B7186"
                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="5" x:Name="StatusText" Margin="0,12,0,0" Foreground="#6B7186" FontSize="11"
                   Text="Live monitoring. Browser traffic (YouTube, Facebook web, etc.) is counted under the browser."/>
    </Grid>
</Window>
